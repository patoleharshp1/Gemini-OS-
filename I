<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages</title>
  <style>
    body { font-family: Arial, sans-serif; background: #120000; color: #fff; margin: 0; padding: 15px; }
    #chat-box { height: 300px; overflow-y: auto; border: 1px solid #444; padding: 10px; margin-bottom: 10px; border-radius: 8px; }
    .message { margin-bottom: 8px; }
    .user { font-weight: bold; color: #ff8a8a; }
    .time { font-size: 0.75em; color: #aaa; margin-left: 5px; }
    .input-container { display: flex; gap: 8px; }
    input { flex: 1; padding: 10px; border-radius: 6px; border: 1px solid #444; background: #222; color: #fff; }
    button { padding: 10px 15px; border: none; background: #e05656; color: white; border-radius: 6px; cursor: pointer; }
  </style>
</head>
<body>

  <h2>Messages</h2>
  <div id="chat-box"></div>

  <div class="input-container">
    <input type="text" id="messageInput" placeholder="Type a message..." />
    <button onclick="sendMessage()">Send</button>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    const chatBox = document.getElementById('chat-box');
    const messageInput = document.getElementById('messageInput');

    // Receive message from server
    socket.on('receive_message', (data) => {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'message';
      msgDiv.innerHTML = `<span class="user">${data.user}:</span> ${data.message} <span class="time">${data.timestamp}</span>`;
      chatBox.appendChild(msgDiv);
      chatBox.scrollTop = chatBox.scrollHeight;
    });

    // Send message to server
    function sendMessage() {
      const text = messageInput.value.trim();
      if (text !== '') {
        socket.emit('send_message', { user: 'User', message: text });
        messageInput.value = '';
      }
    }
  </script>
</body>
</html>
